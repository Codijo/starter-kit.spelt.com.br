# === Repo do Starter Kit (Codijo/starter-kit.spelt.com.br) ===
# Mono-repo: docs/ (spec + ideias) + code/api/ + code/platform/ + code/www/ (templates Laravel).

# Dependências — regeneradas (composer install / npm ci)
**/vendor/
**/node_modules/

# ⚠️ Ambiente — NUNCA versionar segredo. Mantém só os *.example.
**/.env
**/.env.*
!**/.env.example

# Runtime do Laravel (mantém a estrutura de dirs via .gitkeep dos templates)
**/storage/logs/*
!**/storage/logs/.gitkeep
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/*.key
**/bootstrap/cache/*.php
**/public/build/
**/public/hot
**/public/storage

# Sistema
.DS_Store
**/.DS_Store

# Runtime do Mutagen — identificador da sessão local, gerado por `mutagen project start`.
# É por-máquina: versionar faz duas máquinas brigarem pelo mesmo lock.
**/mutagen.yml.lock

# Claude Code — settings.json é do time; settings.local.json é per-máquina.
.claude/settings.local.json
