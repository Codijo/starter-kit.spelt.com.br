APP_NAME="Starter Kit API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Banco ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=starter_kit
DB_USERNAME=root
DB_PASSWORD=

# --- Cache / Fila / Sessão (Redis recomendado) ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
# predis (lib PHP pura) — a imagem pode não ter a extensão phpredis; predis evita depender dela
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Filas por domínio (o worker precisa observar a fila; fallback 'default').
# Some cada fila nova em config/horizon.php (defaults.supervisor-1.queue).
QUEUE_WEBHOOK=default
# retry_after do Redis DEVE ser > maior timeout de worker/job (default 180 em config/queue.php)
# REDIS_QUEUE_RETRY_AFTER=180
# Obs.: o ambiente do Horizon (--environment em .supervisord/Horizon.conf) vem de HORIZON_ENV
# do SHELL do container (compose `environment:`), NÃO deste .env; sem ele → 'production'.

# Gate do dashboard do Horizon (Basic Auth). SEM estes valores, o dashboard fica trancado (401).
HORIZON_BASIC_AUTH_USERNAME=
HORIZON_BASIC_AUTH_PASSWORD=

# =====================================================================
#  Spelt — integração (ver ../docs/technical/starter-kit.md §13 na raiz deste repo do kit)
# =====================================================================
SPELT_API_URL=https://api.spelt.com.br
# Chave da External API v1 (splt_live_… em produção, splt_test_… em dev/CI)
SPELT_API_KEY=
# Segredo do webhook (validado no header Authorization dos webhooks recebidos)
SPELT_WEBHOOK_SECRET=
# (O portal Customer do Seller para o SSO reverso NÃO é env: é aprendido no SSO — vem no
#  payload como `panel_url` e é gravado em accounts.spelt_panel_url.)
# TTL (dias) do token de sessão emitido após o SSO (opcional, default 30)
SPELT_SESSION_TTL_DAYS=30

# --- Produto (branding fixo — o kit atende UM Seller) ---
PRODUCT_NAME="Meu Produto"
PRODUCT_LOGO=/img/logo.svg

# --- Ray (myray.app) — depurador visual (dev). O container roda na VM, então RAY_HOST
#     é o IP do Mac na LAN, não 'localhost'. Deixe em branco para desligar em CI. ---
RAY_HOST=
# RAY_ENABLED=true
