/.phpunit.cache
/bootstrap/cache/*.php
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.idea
/.vscode

# === Ambiente — NUNCA versionar segredo ===
# ATENÇÃO: `.env` sozinho casa SÓ com o arquivo exatamente `.env`.
# Sem `.env.*` os arquivos .env.dev / .env.prd / .env.stg entram no git — foi
# assim que os secrets vazaram no repo do Spelt. Ver CLAUDE.md do deploy.
.env
.env.*
!.env.example

# === Runtime do Laravel (artefato, nunca fonte) ===
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*

# Arquivos de exportação: dado de cliente gerado em runtime. Nunca versionar.
/storage/app/private/exports/*

# === Runtime do Mutagen (por-máquina, nunca versionar) ===
mutagen.yml.lock

# === Claude Code (settings.json é do time; o .local é per-máquina) ===
.claude/settings.local.json

# === Chaves e material criptográfico (nunca versionar) ===
# `/storage/*.key` sozinho NÃO cobre a raiz: a oauth-private.key do Passport
# fica na raiz do projeto. Foi assim que ela vazou em www/customer/backoffice.
*.key
*.pem
!*.key.example

# === Por máquina (não é do projeto) ===
mutagen.yml.lock
