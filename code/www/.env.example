APP_NAME="Starter Kit Site"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Site sem banco: sessão e cache em arquivo, fila síncrona.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# =====================================================================
#  Produto / marca (ver config/site.php)
# =====================================================================
PRODUCT_NAME="Meu Produto"
PRODUCT_LOGO=
# URL da Plataforma (o app) — os CTAs de Entrar/Começar apontam para cá.
APP_PLATFORM_URL=http://localhost
CONTACT_EMAIL=contato@exemplo.com

# =====================================================================
#  Vite (dev, atrás do Traefik). Ajuste o host ao container do site.
# =====================================================================
VITE_URL=http://www.spelt.kit
VITE_HMR_HOST=www.spelt.kit
VITE_HMR_CLIENT_PORT=80
VITE_HMR_PROTOCOL=ws
