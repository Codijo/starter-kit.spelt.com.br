APP_NAME="Starter Kit Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Front sem banco: sessão e cache em arquivo, fila síncrona.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# =====================================================================
#  Produto — o Platform consome a API do PRÓPRIO produto (o kit API)
# =====================================================================
# URL da API do produto. Usada server-side (troca do token SSO) e client-side (axios).
# Dev: exponha o host público como ALIAS de rede no nginx do seu deploy (docker-compose),
# assim o container resolve a própria API sem host interno nem header manual.
PRODUCT_API_URL=http://localhost:8000
PRODUCT_NAME="Meu Produto"
PRODUCT_LOGO=

# Vite (dev, atrás do Traefik). VITE_URL = URL PÚBLICA do Platform: faz o @vite emitir
# assets nesse host (ex.: http://platform.spelt.kit), que o Traefik roteia ao dev server.
# Sem isso o hot file vira http://0.0.0.0:5173 e o browser não alcança.
VITE_URL=http://platform.spelt.kit
VITE_HMR_HOST=platform.spelt.kit
VITE_HMR_CLIENT_PORT=80
VITE_HMR_PROTOCOL=ws
